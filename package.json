    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.576.0",
    "next": "16.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5"
  },
  "browserslist": {
    "production": [
      "chrome >= 111",
