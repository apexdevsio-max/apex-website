{
  "$schema": "https://json.schemastore.org/package",
  "name": "apex_website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typegen": "next typegen",
    "predev": "next typegen",
    "prebuild": "next typegen",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./tests/register.mjs --test tests/*.test.mjs",
