NEXT_PUBLIC_SITE_URL=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=APEX Contact <contact@your-verified-domain.com>
CONTACT_TO_EMAIL=contact@your-domain.com
# Durable rate limiting for /api/contact. Without both of these the endpoint falls
# back to an in-memory counter that is per-instance and resets on every cold start,
# so on serverless the 3-per-hour limit is bypassed by spreading submissions across
# instances. The route logs a warning once per process while they are unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Also configure bot protection for /api/contact at the CDN/firewall layer.

# Public identity. These feed the visible contact points and the `sameAs` array in
# the Organization JSON-LD, which is how Google and AI answer engines tie this site
# to one real-world company. Leaving the social profiles blank is safe but emits an
# empty `sameAs`, measurably weakening those entity signals — fill each in with the
# full profile URL as the accounts go live.
# Prefer an address on the company domain over a free-mail one: a gmail.com address
# as a company's public contact is a strong "not an established business" signal.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_TWITTER=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics only loads after the
# visitor accepts the consent banner; leaving this blank disables it entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Named author for the technical and compliance guides. These describe a PERSON,
# not the company — a personal portfolio inside the Organization's `sameAs` tells
# search engines that APEX and the individual are one entity, which weakens
# entity resolution. They are emitted as a separate Person node linked to the
# company via `worksFor`. Leaving NEXT_PUBLIC_AUTHOR_NAME blank attributes every
# article to "APEX Team" with no Person node, which is a safe default.
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_NAME_AR=
NEXT_PUBLIC_AUTHOR_TITLE=
NEXT_PUBLIC_AUTHOR_TITLE_AR=
NEXT_PUBLIC_AUTHOR_URL=
NEXT_PUBLIC_AUTHOR_LINKEDIN=
NEXT_PUBLIC_AUTHOR_GITHUB=
